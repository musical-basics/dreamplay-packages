{
  "name": "@dreamplay/emailer",
  "version": "0.1.0",
  "private": true,
  "description": "Installable DreamPlay email engine helpers for business apps.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./agent-server": {
      "types": "./dist/agent-server.d.ts",
      "import": "./dist/agent-server.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./send-server": {
      "types": "./dist/send-server.d.ts",
      "import": "./dist/send-server.js"
    },
    "./tracking-server": {
      "types": "./dist/tracking-server.d.ts",
      "import": "./dist/tracking-server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.2",
    "resend": "^6.6.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  }
}
