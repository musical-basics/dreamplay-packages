{
  "name": "@dreamplay/analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Business-isolated analytics tracker and shared analytics helpers for DreamPlay repos.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "supabase", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./classification": {
      "types": "./dist/classification.d.ts",
      "import": "./dist/classification.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js"
    },
    "./dashboard-server": {
      "types": "./dist/dashboard-server.d.ts",
      "import": "./dist/dashboard-server.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.2",
    "lucide-react": "^1.14.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  }
}
